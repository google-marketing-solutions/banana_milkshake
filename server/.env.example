# Server Port (Optional, defaults to 3001)
PORT=3001

# Gemini Authentication (Required for AI generation)
GEMINI_API_KEY="your_gemini_api_key_here"
API_KEY="your_gemini_api_key_here"

# Vertex AI Configuration (Optional, if using Google Cloud Vertex AI instead of AI Studio)
GOOGLE_CLOUD_PROJECT="your_gcp_project_id"
GOOGLE_CLOUD_LOCATION="global"

# Google Drive API / OAuth Configuration (Used for frontend integration)
DRIVE_API_KEY="your_drive_api_key_here"
GOOGLE_CLIENT_ID="your_google_client_id_here"
